# IceStream Platform Configuration

# Service Ports & Host
HOST=0.0.0.0
PORT=3000
API_PORT=8000
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
FLINK_UI_PORT=8081
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
ICEBERG_REST_PORT=8181

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CHECKOUT_TOPIC=checkout-events
KAFKA_VALID_TOPIC=checkout-events-valid
KAFKA_INVALID_TOPIC=checkout-events-invalid
KAFKA_DLQ_TOPIC=checkout-events-dlq
KAFKA_PIPELINE_EVENTS_TOPIC=pipeline-events
KAFKA_ALERTS_TOPIC=quality-alerts
KAFKA_REMEDIATION_TOPIC=remediation-events

# Transaction Generator Settings
EVENTS_PER_SECOND=250
ANOMALY_RATE=0.01
SCHEMA_DRIFT_RATE=0.005
NULL_RATE=0.01

# Data Quality & Circuit Breaker Thresholds
ERROR_RATE_THRESHOLD=0.02
NULL_RATE_WARNING_THRESHOLD=0.02
NULL_RATE_CRITICAL_THRESHOLD=0.05
CIRCUIT_BREAKER_RECOVERY_TIME_SEC=15
HALF_OPEN_SAMPLE_SIZE=50
SLIDING_WINDOW_SECONDS=60

# Apache Iceberg & MinIO Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=lakehouse
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse

# Apache Flink Configuration
FLINK_JOBMANAGER_URL=http://flink-jobmanager:8081
FLINK_PARALLELISM=2

# API & WebSocket
API_URL=http://api:8000
WS_URL=ws://api:8000/ws
